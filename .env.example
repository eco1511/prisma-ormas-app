MONGODB_URI=mongodb://127.0.0.1:27017/prisma_anggota
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_APP_NAME=PRISMA
# UPLOAD_DIR=C:/prisma-next-mongodb/storage/uploads
APP_URL=http://localhost:3000
# Gmail: aktifkan Verifikasi 2 Langkah, lalu buat App Password.
# Isi alamat Gmail pengirim pada SMTP_USER dan SMTP_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_TYPE=password
SMTP_USER=your-email@example.com
# App Password Gmail 16 karakter, bukan password login Google.
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Prisma <your-email@example.com>"
